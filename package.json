{
  "name": "orca-team-orchestration",
  "version": "0.0.0",
  "description": "Role-based multi-agent development pipeline for any repository",
  "license": "MIT",
  "type": "module",
  "bin": {
    "orca-team-orchestration": "dist/src/cli/index.js"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist/src",
    "public",
    "templates",
    "LICENSE"
  ],
  "scripts": {
    "dev": "npm run build && node dist/src/ui/server.js",
    "start": "npm run dev",
    "build": "tsc -p tsconfig.json && node -e \"require('node:fs').chmodSync('dist/src/cli/index.js', 0o755)\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test \"dist/test/*.test.js\""
  },
  "dependencies": {
    "minimatch": "^9.0.5",
    "yaml": "^2.6.0"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "typescript": "^5.6.3"
  }
}
